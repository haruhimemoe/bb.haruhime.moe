# Copy to .env.local and fill in. Never commit real values: secrets stay empty here.

# MongoDB connection string, like mongodb+srv://user:password@cluster.example.net. The app uses the "bb"
# database whatever the URI names, and reads the haruhime.moe hub's "identity" database (users and
# sessions) on the same cluster. bb's database user needs readWrite on bb and only read on identity.
MONGODB_URI=

# The haruhime.moe hub's BETTER_AUTH_SECRET (the same value): bb checks the hub's session cookie with it.
# Sign-in itself runs only on the hub.
BETTER_AUTH_SECRET=

# osu! OAuth app (https://osu.ppy.sh/home/account/edit#oauth): its client ID (a number, 12345 is only an
# example) and secret. bb uses them for osu! API lookups (client credentials), not for sign-in.
OSU_CLIENT_ID=12345
OSU_CLIENT_SECRET=

# osu! user ids with admin rights (clearing reported templates), comma-separated, like 1234567,7654321.
# Empty means nobody is an admin.
ADMIN_OSU_IDS=

# Where pools lives, for importing pools into the editor. Empty means https://pools.haruhime.moe.
POOLS_URL=

# The haruhime.moe hub: sign-in, the account page and session refreshes. Empty means https://www.haruhime.moe.
HUB_URL=

# Optional, CI only. Builds without real secrets by using placeholders nothing connects with.
# SKIP_ENV_VALIDATION=true
